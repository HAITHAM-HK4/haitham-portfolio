<file path="cv.css">
/* ================================================================
   cv.css  —  CYBER IONIC EDITION
   Ionic Blue / Neon Green / Slate Dark
   ================================================================ */

@import url('https://fonts.googleapis.com/css2?family=Syne:wght@400;500;600;700;800&family=JetBrains+Mono:wght@300;400;500;600;700&display=swap');

* {
    margin: 0; padding: 0;
    box-sizing: border-box;
    text-decoration: none; border: none; outline: none;
    scroll-behavior: smooth;
}

:root {
    /* Backgrounds: Dark Slate/Blue */
    --bg:           #020617; 
    --bg2:          #0f172a;
    --bg3:          #1e293b;
    
    /* Primary Colors: Ionic Blue & Concentrated Green */
    --ionic-blue:   #00d2ff; 
    --ionic-dark:   #0097b2;
    --neon-green:   #00fa9a;
    
    /* Glows & Dims */
    --blue-dim:     rgba(0, 210, 255, 0.08);
    --blue-glow:    rgba(0, 210, 255, 0.4);
    --green-glow:   rgba(0, 250, 154, 0.25);
    
    /* Text Colors */
    --text:         #ffffff;       /* Pure White for readability */
    --text-dim:     #94a3b8;       /* Slate gray for secondary */
    --text-mid:     #e2e8f0;       /* Light gray for descriptions */
    
    /* Borders & Glass */
    --border:       rgba(0, 210, 255, 0.25);
    --border2:      rgba(0, 250, 154, 0.45);
    --glass:        rgba(15, 23, 42, 0.65);
    --red:          #ef4444;
    
    /* Fonts */
    --font-body:    'JetBrains Mono', 'Courier New', monospace;
    --font-display: 'Syne', sans-serif;
}

/* ===== BASE ===== */
html {
    background: var(--bg);
}
body {
    background: transparent;
    color: var(--text);
    font-family: var(--font-body);
    cursor: none;
    overflow-x: hidden;
}

/* Ambient glow layers */
body::before {
    content: '';
    position: fixed; inset: 0; pointer-events: none; z-index: 0;
    background:
        radial-gradient(ellipse 70% 50% at 50% -10%, rgba(0, 210, 255, 0.12) 0%, transparent 60%),
        radial-gradient(ellipse 60% 40% at 95% 95%,  rgba(0, 250, 154, 0.08) 0%, transparent 55%),
        radial-gradient(ellipse 50% 35% at 5%  85%,  rgba(0, 210, 255, 0.06) 0%, transparent 50%);
}

section { min-height: 100vh; padding: 12rem 9% 4rem; position: relative; z-index: 1; }

/* ===== HEADINGS ===== */
.heading {
    text-align: center;
    font-family: var(--font-display);
    font-size: 4.2rem; font-weight: 800;
    color: #fff; margin-bottom: 5rem;
    letter-spacing: 2px; text-transform: uppercase;
    position: relative;
}
.heading span {
    background: linear-gradient(135deg, var(--ionic-blue) 0%, var(--neon-green) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 20px rgba(0, 210, 255, 0.4));
}
.heading::after {
    content: '';
    display: block; width: 6rem; height: 3px;
    background: linear-gradient(90deg, transparent, var(--ionic-blue), var(--neon-green), transparent);
    margin: 1.5rem auto 0; border-radius: 2px;
    box-shadow: 0 0 18px var(--blue-glow);
}

/* ===== RTL ===== */
html[dir="rtl"] body { direction: ltr !important; }
html[dir="rtl"] .home-content, html[dir="rtl"] .about-content,
html[dir="rtl"] .heading, html[dir="rtl"] .portfolio-layer,
html[dir="rtl"] .contact form, html[dir="rtl"] .popup-box,
html[dir="rtl"] .about-info-item, html[dir="rtl"] .skill-card { direction: rtl; text-align: right; }
html[dir="rtl"] .navbar { direction: rtl; }
html[dir="rtl"] .social-media { direction: ltr; }

/* ===== CURSOR ===== */
#cursor-dot {
    position: fixed; top: 0; left: 0;
    width: 10px; height: 10px; background: var(--ionic-blue);
    border-radius: 50%; pointer-events: none; z-index: 99999;
    transform: translate(-50%, -50%);
    box-shadow: 0 0 14px var(--blue-glow), 0 0 35px rgba(0, 210, 255, 0.4);
    transition: width .2s, height .2s; will-change: left, top;
}
#cursor-ring {
    position: fixed; top: 0; left: 0;
    width: 40px; height: 40px;
    border: 1.5px solid rgba(0, 250, 154, 0.7);
    border-radius: 50%; pointer-events: none; z-index: 99998;
    transform: translate(-50%, -50%);
    transition: width .3s, height .3s, border-color .3s; will-change: left, top;
}

/* ===== SCROLL PROGRESS ===== */
.scroll-progress {
    position: fixed; top: 0; left: 0; height: 2px;
    background: linear-gradient(90deg, var(--ionic-dark), var(--ionic-blue), var(--neon-green));
    box-shadow: 0 0 12px var(--blue-glow);
    width: 0%; z-index: 10000; transition: width .1s ease-out;
}

/* ===== HEADER ===== */
@keyframes navSlideDown {
    from { opacity: 0; transform: translateX(-50%) translateY(-130%); }
    to   { opacity: 1; transform: translateX(-50%) translateY(0); }
}
.header {
    position: fixed; top: 1.2rem; left: 50%;
    transform: translateX(-50%) translateY(-130%); opacity: 0;
    width: auto; max-width: 95vw;
    padding: 0.55rem 1.2rem;
    background: rgba(2, 6, 23, 0.85);
    backdrop-filter: blur(24px);
    border: 1px solid var(--border2); border-radius: 6rem;
    display: flex; align-items: center; gap: 0.6rem;
    z-index: 9000; pointer-events: none;
    box-shadow: 0 0 35px rgba(0, 210, 255, 0.15), inset 0 0 30px rgba(0, 250, 154, 0.05);
    transition: transform .5s cubic-bezier(.34,1.56,.64,1), opacity .35s ease;
}
.header.nav-visible {
    transform: translateX(-50%) translateY(0); opacity: 1; pointer-events: all;
    animation: navSlideDown .5s cubic-bezier(.34,1.56,.64,1) both;
}
.logo img { height: 2.8rem; filter: drop-shadow(0 0 8px var(--ionic-blue)); display: block; }
.nav-sep { width: 1px; height: 1.4rem; background: var(--border); margin: 0 .4rem; }
.navbar { display: flex; align-items: center; gap: .2rem; }
.navbar a {
    font-family: var(--font-body); font-size: 1.1rem;
    color: var(--text-dim); font-weight: 500;
    padding: .5rem 1rem; border-radius: 3rem; transition: .3s; cursor: none;
}
.navbar a:hover, .navbar a.active {
    color: var(--text); background: rgba(0, 210, 255, 0.15);
    text-shadow: 0 0 12px var(--blue-glow);
    border-bottom: 2px solid var(--ionic-blue);
}
.lang-switcher {
    display: flex; align-items: center; gap: .4rem;
    padding: .45rem 1rem; border-radius: 3rem;
    border: 1px solid var(--border);
    cursor: none; font-size: 1rem; color: var(--ionic-blue); transition: .3s;
}
.lang-switcher:hover { background: var(--ionic-blue); color: var(--bg); border-color: var(--ionic-blue); box-shadow: 0 0 15px var(--blue-glow); }
.dash-btn {
    width: 3.2rem; height: 3.2rem; border-radius: 50%;
    border: 1px solid var(--border2); background: var(--blue-dim);
    display: flex; align-items: center; justify-content: center;
    font-size: 1.4rem; color: var(--neon-green); cursor: none; transition: .3s;
}
.dash-btn:hover { background: var(--neon-green); color: var(--bg); box-shadow: 0 0 20px var(--green-glow); }

/* ===== HOME ===== */
.home { display: flex; justify-content: center; align-items: center; gap: 6rem; }

.home-content h3 {
    font-family: var(--font-display); font-size: 1.8rem; font-weight: 500;
    color: var(--text-dim); letter-spacing: 4px; text-transform: uppercase;
}
.home-content h1 {
    font-family: var(--font-display); font-size: 5.8rem; font-weight: 800;
    letter-spacing: 3px; text-transform: uppercase; line-height: 1.05;
    background: linear-gradient(135deg, #ffffff 20%, var(--ionic-blue) 60%, var(--neon-green) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 30px rgba(0, 210, 255, 0.25));
}
span.multiple-text {
    background: linear-gradient(90deg, var(--ionic-blue), var(--neon-green));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.multiple-text::after {
    content: '|'; -webkit-text-fill-color: var(--ionic-blue);
    animation: blink .7s infinite; margin-left: 3px;
}
@keyframes blink { 0%,100%{opacity:1;} 50%{opacity:0;} }
.home-content h3.typerow { font-size: 2.2rem; margin: 1rem 0; }
.home-content p { font-size: 1.5rem; margin: 2rem 0; color: var(--text-mid); line-height: 2; max-width: 52rem; }

.social-media a {
    display: inline-flex; justify-content: center; align-items: center;
    width: 4.4rem; height: 4.4rem;
    border: 1px solid var(--border); border-radius: 50%;
    font-size: 1.8rem; color: var(--ionic-blue);
    margin: 2rem 1.2rem 2rem 0; transition: .4s ease; cursor: none;
    background: var(--blue-dim); backdrop-filter: blur(8px);
}
.social-media a:hover {
    background: var(--ionic-blue); color: var(--bg); border-color: var(--ionic-blue);
    box-shadow: 0 0 25px var(--blue-glow), 0 0 50px var(--green-glow);
    transform: translateY(-5px) scale(1.1);
}


/* ===== HEXAGON ===== */
@keyframes breathe {
    0%,100% { filter: drop-shadow(0 0 15px var(--ionic-blue)) drop-shadow(0 0 40px rgba(0, 210, 255, 0.2)); transform: translateY(0); }
    50%      { filter: drop-shadow(0 0 30px var(--neon-green)) drop-shadow(0 0 70px rgba(0, 250, 154, 0.25)); transform: translateY(-14px); }
}
.breathe-animation { animation: breathe 7s infinite ease-in-out; }
.hexagon-svg { width: 470px; height: 415px; overflow: visible; }
.hexagon-svg polygon { fill: none; stroke: url(#hexGrad); stroke-width: 3; }

/* ===== BUTTONS ===== */
.btn {
    padding: 1.2rem 3rem; font-family: var(--font-display);
    font-size: 1.3rem; font-weight: 700;
    cursor: none; transition: .4s; text-align: center;
    letter-spacing: 2px; text-transform: uppercase;
    border-radius: .8rem; display: inline-block; position: relative; overflow: hidden;
}
.btn-primary {
    background: linear-gradient(135deg, var(--ionic-dark), var(--ionic-blue), var(--neon-green));
    color: var(--bg);
    box-shadow: 0 0 25px var(--blue-glow), 0 4px 20px rgba(0, 250, 154, 0.2);
}
.btn-primary:hover { 
    box-shadow: 0 0 45px var(--green-glow), 0 8px 30px rgba(0, 210, 255, 0.4); 
    transform: translateY(-3px); 
    filter: brightness(1.2); 
    color: var(--bg);
}
.btn-outline {
    background: transparent; color: var(--ionic-blue);
    border: 1.5px solid var(--border2);
    box-shadow: 0 0 14px var(--green-glow), inset 0 0 14px var(--blue-dim);
}
.btn-outline:hover { 
    background: var(--ionic-blue); color: var(--bg); 
    border-color: var(--ionic-blue); 
    box-shadow: 0 0 35px var(--blue-glow); 
    transform: translateY(-3px); 
}

/* ===== ABOUT ===== */
.about { display: flex; gap: 4rem; align-items: stretch; }
.about-card {
    flex: 1; background: var(--glass); backdrop-filter: blur(24px);
    border: 1px solid var(--border); border-radius: 1.5rem; padding: 4rem;
    transition: .4s; position: relative; overflow: hidden;
}
.about-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--ionic-blue), var(--neon-green), transparent);
    box-shadow: 0 0 18px var(--green-glow);
}
.about-card:hover { border-color: var(--border2); transform: translateY(-4px); box-shadow: 0 0 50px rgba(0, 210, 255, 0.1); }
.about-card-desc { font-size: 1.55rem; color: var(--text-mid); line-height: 2; }
.about-info-grid {
    display: grid; grid-template-columns: 1fr 1fr; gap: 2rem;
    border-top: 1px solid var(--border); border-bottom: 1px solid var(--border);
    padding: 2.5rem 0; margin-top: 2.5rem;
}
.about-info-item { display: flex; flex-direction: column; gap: .4rem; }
.about-info-label { font-size: 1.1rem; color: var(--ionic-blue); font-weight: 600; text-transform: uppercase; letter-spacing: 2px; }
.about-info-value { font-size: 1.4rem; color: #fff; font-weight: 500; }
.about-card-btns { display: flex; gap: 1.5rem; padding-top: 2.5rem; flex-wrap: wrap; }

.about-photo {
    flex: 0.75; padding: 1.5rem; background: var(--glass);
    border: 1px solid var(--border); border-radius: 1.5rem; position: relative; overflow: hidden;
}
.about-photo::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--neon-green), var(--ionic-blue), transparent);
    box-shadow: 0 0 18px var(--blue-glow);
}
.about-photo-img { width: 100%; height: 100%; object-fit: cover; border-radius: 1rem; transition: .5s; filter: saturate(0.85); }
.about-photo:hover .about-photo-img { filter: saturate(1.1); }
.about-photo-img {
    position: absolute;
    width: 100%;
    height: 100%;
    border-radius: 10px;
    object-fit: cover;
    filter: brightness(0.7);
}

/* ===== SKILLS ===== */
.skills-section { background: transparent; text-align: center; }
.skills-label {
    display: inline-block; font-family: var(--font-body); font-size: 1.2rem;
    color: var(--ionic-blue); background: var(--blue-dim);
    border: 1px solid var(--border2); border-radius: 5rem;
    padding: .5rem 2rem; margin-bottom: 1.5rem; letter-spacing: 3px; text-transform: uppercase;
}
.skills-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(340px, 1fr)); gap: 2.5rem; max-width: 1200px; margin: auto; }
.skill-card {
    background: var(--glass); border: 1px solid var(--border);
    border-radius: 1.2rem; padding: 3rem; transition: .4s; position: relative; overflow: hidden; text-align: left;
}
.skill-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 2px;
    background: linear-gradient(90deg, transparent, var(--ionic-blue), transparent); opacity: 0; transition: .4s;
}
.skill-card:hover::before { opacity: 1; }
.skill-card:hover { transform: translateY(-6px); border-color: var(--border2); box-shadow: 0 15px 40px rgba(0,0,0,0.5), 0 0 25px var(--green-glow); }
.skill-card-title { font-family: var(--font-display); font-size: 2rem; font-weight: 700; color: #fff; margin-bottom: 1rem; }
.skill-card-desc { font-size: 1.35rem; color: var(--text-mid); margin-bottom: 2rem; line-height: 1.8; }
.skill-tags { display: flex; flex-wrap: wrap; gap: .8rem; }
.skill-tag {
    font-size: 1.1rem; color: var(--text); background: rgba(0, 210, 255, 0.08);
    border: 1px solid var(--border); border-radius: 5rem; padding: .4rem 1.2rem; transition: .3s;
}
.skill-tag:hover { background: var(--ionic-blue); color: var(--bg); border-color: var(--ionic-blue); box-shadow: 0 0 12px var(--blue-glow); }

/* ===== PROJECTS ===== */
.portfolio { background: transparent; }
.bento-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)); gap: 2.5rem; max-width: 1300px; margin: auto; }
.bento-card {
    background: var(--glass); border: 1px solid var(--border);
    border-radius: 1.5rem; overflow: hidden; display: flex; flex-direction: column;
    backdrop-filter: blur(24px); transition: .45s cubic-bezier(.22,.68,0,1.2); position: relative;
}
.bento-card:hover {
    transform: translateY(-10px) scale(1.015);
    border-color: var(--border2);
    box-shadow: 0 25px 60px rgba(0,0,0,0.65), 0 0 30px rgba(0, 210, 255, 0.18);
}
.bento-img-area { position: relative; height: 23rem; overflow: hidden; }
.bento-img-area img { width: 100%; height: 100%; object-fit: cover; transition: .7s; filter: saturate(0.8) brightness(0.9); }
.bento-card:hover .bento-img-area img { transform: scale(1.08); filter: saturate(1.1) brightness(1); }
.bento-img-area::after {
    content: ''; position: absolute; inset: 0;
    background: linear-gradient(to bottom, rgba(2,6,23,0) 40%, rgba(2,6,23,0.95));
}
.bento-img-count {
    position: absolute; top: 1.2rem; right: 1.2rem; z-index: 2;
    background: rgba(2,6,23,0.8); backdrop-filter: blur(5px);
    border: 1px solid var(--border2); border-radius: 5rem;
    padding: .4rem 1.2rem; color: var(--neon-green); font-weight: 600; font-size: 1.1rem;
}
.bento-body { padding: 2.5rem; display: flex; flex-direction: column; flex-grow: 1; gap: 1.5rem; position: relative; z-index: 2; }
.bento-name { font-family: var(--font-display); font-size: 2.1rem; font-weight: 700; color: #fff; transition: .3s; }
.bento-card:hover .bento-name {
    background: linear-gradient(90deg, var(--ionic-blue), var(--neon-green));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.bento-tags { display: flex; flex-wrap: wrap; gap: .8rem; }
.bento-tag { font-size: 1rem; color: var(--ionic-blue); background: rgba(0, 210, 255, 0.08); padding: .3rem 1rem; border: 1px solid var(--border); border-radius: 5rem; }
.bento-desc { font-size: 1.35rem; color: var(--text-mid); line-height: 1.7; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.bento-actions { display: flex; gap: 1rem; margin-top: auto; }
.bento-btn-visit, .bento-btn-desc {
    flex: 1; padding: 1.1rem; font-family: var(--font-display); font-size: 1.2rem; font-weight: 700;
    cursor: none; text-align: center; transition: .35s; letter-spacing: 1px; text-transform: uppercase; border-radius: .8rem;
}
.bento-btn-visit { background: linear-gradient(135deg, var(--ionic-blue), var(--neon-green)); color: var(--bg); box-shadow: 0 0 15px var(--green-glow); }
.bento-btn-visit:hover { filter: brightness(1.15); box-shadow: 0 0 25px var(--blue-glow); transform: translateY(-2px); }
.bento-btn-desc { background: var(--blue-dim); color: var(--ionic-blue); border: 1px solid var(--border); }
.bento-btn-desc:hover { background: var(--ionic-blue); color: var(--bg); border-color: var(--ionic-blue); transform: translateY(-2px); }

/* ===== POPUP ===== */
.desc-popup-overlay {
    display: none; position: fixed; inset: 0;
    background: rgba(2,6,23,0.95); backdrop-filter: blur(16px);
    z-index: 10001; align-items: center; justify-content: center;
}
.desc-popup-overlay.open { display: flex; }
.desc-popup-box {
    background: var(--bg3); border: 1px solid var(--border2);
    border-radius: 1.5rem; padding: 4.5rem; max-width: 60rem; width: 90%;
    box-shadow: 0 0 60px rgba(0, 210, 255, 0.2), inset 0 0 40px rgba(0, 250, 154, 0.05);
    position: relative; animation: popIn .4s cubic-bezier(.22,.68,0,1.2);
}
@keyframes popIn { from{transform:scale(.85) translateY(20px);opacity:0;} to{transform:scale(1);opacity:1;} }
.desc-popup-close {
    position: absolute; top: 2rem; right: 2rem; width: 3.8rem; height: 3.8rem;
    border-radius: 50%; border: 1px solid var(--border); background: var(--blue-dim);
    color: var(--ionic-blue); font-size: 1.6rem; cursor: none; transition: .3s;
    display: flex; align-items: center; justify-content: center;
}
.desc-popup-close:hover { background: var(--red); border-color: var(--red); color: #fff; transform: rotate(90deg); }
.desc-popup-title {
    font-family: var(--font-display); font-size: 2.8rem; font-weight: 700; margin-bottom: 2rem;
    background: linear-gradient(135deg, var(--ionic-blue), var(--neon-green));
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
}
.desc-popup-text { font-size: 1.55rem; color: var(--text-mid); line-height: 1.9; }

/* ===== EDUCATION ===== */
.education-section { background: transparent; }
.edu-card {
    background: var(--glass); border: 1px solid var(--border); border-radius: 1.5rem; padding: 4rem;
    max-width: 900px; margin: auto; position: relative; overflow: hidden; transition: .4s;
}
.edu-card::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--ionic-blue), var(--neon-green), transparent);
    box-shadow: 0 0 20px var(--green-glow);
}
.edu-card:hover { border-color: var(--border2); box-shadow: 0 0 45px rgba(0, 210, 255, 0.15); }
.edu-header-info h3 { font-family: var(--font-display); font-size: 2.2rem; font-weight: 700; color: #fff; }
.edu-header-info p { font-size: 1.4rem; color: var(--ionic-blue); margin-top: .8rem; }
.edu-divider { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }
.edu-desc { font-size: 1.45rem; color: var(--text-mid); line-height: 2; }

/* ===== CONTACT ===== */
.contact { background: transparent; }
.contact-container { display: flex; gap: 3rem; max-width: 1200px; margin: auto; }
.contact-glass-card, .contact-form-wrapper {
    flex: 1; background: var(--glass); border: 1px solid var(--border);
    border-radius: 1.5rem; padding: 4rem; position: relative; overflow: hidden;
}
.contact-glass-card::before, .contact-form-wrapper::before {
    content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, transparent, var(--neon-green), var(--ionic-blue), transparent);
    box-shadow: 0 0 20px var(--blue-glow);
}
/* تقليل الـ margin هنا قليلاً ليتسع لخمسة عناصر براحة */
.info-tile { display: flex; align-items: center; gap: 1.5rem; margin-bottom: 1.8rem; }
.tile-icon {
    width: 5rem; height: 5rem; flex-shrink: 0;
    background: var(--blue-dim); border: 1px solid var(--border2);
    border-radius: 1rem; display: flex; align-items: center; justify-content: center;
    font-size: 1.9rem; color: var(--ionic-blue); transition: .3s;
}
.info-tile:hover .tile-icon { background: linear-gradient(135deg, var(--ionic-blue), var(--neon-green)); color: var(--bg); box-shadow: 0 0 20px var(--green-glow); }
.tile-label { font-size: 1.1rem; color: var(--text-dim); letter-spacing: 2px; text-transform: uppercase; }
.tile-value { font-size: 1.45rem; color: #fff; font-weight: 500; margin-top: .2rem; }
.tile-value a { color: inherit; transition: .3s; }
.tile-value a:hover { color: var(--ionic-blue); }
.contact-single-input, .contact form textarea {
    width: 100%; padding: 1.4rem 1.6rem;
    background: rgba(15,23,42,0.5); border: 1px solid var(--border); border-radius: .8rem;
    color: var(--text); font-family: var(--font-body); font-size: 1.4rem;
    margin-bottom: 2rem; cursor: none; transition: .3s;
}
.contact-single-input::placeholder, .contact form textarea::placeholder { color: var(--text-dim); }
.contact-single-input:focus, .contact form textarea:focus { border-color: var(--ionic-blue); background: rgba(15,23,42,0.8); box-shadow: 0 0 20px var(--blue-glow); outline: none; }

/* ===== FOOTER ===== */
.footer {
    text-align: center; padding: 3rem;
    border-top: 1px solid var(--border); margin-top: 3rem;
    color: var(--text-dim); font-size: 1.3rem;
}
.footer span { background: linear-gradient(90deg, var(--ionic-blue), var(--neon-green)); -webkit-background-clip: text; -webkit-text-fill-color: transparent; font-weight: 600; }

/* ===== LOADER ===== */
#page-loader {
    position: fixed; inset: 0; z-index: 99999;
    background: #020617;
    display: flex; flex-direction: column;
    align-items: center; justify-content: center;
    gap: 0;
    transition: opacity .7s ease, visibility .7s ease;
}
#page-loader.hide {
    opacity: 0; visibility: hidden; pointer-events: none;
}

/* Ambient orbs */
#page-loader::before,
#page-loader::after {
    content: '';
    position: absolute; border-radius: 50%;
    filter: blur(80px); pointer-events: none;
    animation: orbFloat 4s ease-in-out infinite alternate;
}
#page-loader::before {
    width: 45vw; height: 45vw;
    background: radial-gradient(circle, rgba(0,210,255,0.13) 0%, transparent 70%);
    top: -10%; left: -10%;
}
#page-loader::after {
    width: 35vw; height: 35vw;
    background: radial-gradient(circle, rgba(0,250,154,0.09) 0%, transparent 70%);
    bottom: -8%; right: -8%;
    animation-delay: -2s;
}
@keyframes orbFloat {
    0%   { transform: translate(0,0) scale(1); }
    100% { transform: translate(4%,4%) scale(1.1); }
}

/* Grid lines overlay */
.loader-grid {
    position: absolute; inset: 0; pointer-events: none;
    background-image:
        linear-gradient(rgba(0,210,255,0.03) 1px, transparent 1px),
        linear-gradient(90deg, rgba(0,210,255,0.03) 1px, transparent 1px);
    background-size: 60px 60px;
    mask-image: radial-gradient(ellipse 80% 80% at 50% 50%, black 30%, transparent 100%);
}

/* Avatar ring */
.loader-avatar-wrap {
    position: relative;
    width: 13rem; height: 13rem;
    margin-bottom: 3.2rem;
    display: flex; align-items: center; justify-content: center;
}
.loader-avatar-ring {
    position: absolute; inset: 0; border-radius: 50%;
    border: 1.5px solid rgba(0,210,255,0.2);
    animation: ringPulse 2s ease-in-out infinite;
}
.loader-avatar-ring:nth-child(2) {
    inset: -10px;
    border-color: rgba(0,250,154,0.12);
    animation-delay: -.6s; animation-duration: 2.4s;
}
.loader-avatar-ring:nth-child(3) {
    inset: -22px;
    border-color: rgb(0, 208, 255);
    animation-delay: -1.2s; animation-duration: 3s;
}
@keyframes ringPulse {
    0%,100% { opacity: .5; transform: scale(1); }
    50%      { opacity: 1; transform: scale(1.04); box-shadow: 0 0 22px rgba(0,210,255,.2); }
}

/* Spinning arc */
.loader-arc {
    position: absolute; inset: -6px; border-radius: 50%;
    border: 2px solid transparent;
    border-top-color: var(--ionic-blue);
    border-right-color: rgba(0,210,255,.3);
    box-shadow: 0 0 18px rgba(255, 0, 0, 0.35);
    animation: arcSpin 2.2s linear infinite;
}
.loader-arc-2 {
    position: absolute; inset: -14px; border-radius: 50%;
    border: 1.5px solid transparent;
    border-bottom-color: var(--neon-green);
    border-left-color: rgb(250, 0, 0);
    box-shadow: 0 0 14px rgba(0,250,154,.2);
    animation: arcSpin 3.5s linear infinite reverse;
}
@keyframes arcSpin { to { transform: rotate(360deg); } }

/* Avatar image */
.loader-avatar {
    width: 10rem; height: 10rem; border-radius: 50%;
    object-fit: cover; object-position: center top;
    border: 2px solid rgb(0, 0, 0);
    box-shadow:
        0 0 0 4px rgba(0,210,255,0.07),
        0 0 40px rgba(0,210,255,0.25),
        0 0 80px rgba(0,210,255,0.1);
    animation: avatarGlow 2s ease-in-out infinite alternate;
    position: relative; z-index: 2;
}
@keyframes avatarGlow {
    0%   { box-shadow: 0 0 0 4px rgba(0,210,255,.07), 0 0 30px rgba(0,210,255,.2),  0 0 60px rgba(0,210,255,.08); }
    100% { box-shadow: 0 0 0 6px rgba(0,210,255,.12), 0 0 55px rgba(0,210,255,.35), 0 0 90px rgba(0,210,255,.15); }
}

/* Name & tag */
.loader-name {
    font-family: var(--font-display);
    font-size: 2.4rem; font-weight: 800;
    letter-spacing: 4px; text-transform: uppercase;
    background: linear-gradient(90deg, var(--ionic-blue) 0%, var(--neon-green) 100%);
    -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 0 14px rgba(0,210,255,.4));
    margin-bottom: .6rem;
}
.loader-tag {
    font-family: var(--font-body);
    font-size: 1rem; letter-spacing: 5px;
    color: rgba(0,210,255,.55);
    text-transform: uppercase;
    margin-bottom: 3rem;
}

/* Progress bar */
.loader-bar-wrap {
    width: min(36rem, 82vw);
    display: flex; flex-direction: column; gap: 1rem;
}
.loader-bar-track {
    width: 100%; height: 2px;
    background: rgba(0,210,255,.08);
    border-radius: 5rem; overflow: hidden;
    position: relative;
}
.loader-bar-fill {
    height: 100%;
    background: linear-gradient(90deg, var(--ionic-blue), var(--neon-green));
    box-shadow: 0 0 10px rgba(0,210,255,.6);
    border-radius: 5rem;
    width: 0%;
    animation: barFill 3.7s cubic-bezier(.4,0,.2,1) forwards;
}
@keyframes barFill {
    0%   { width: 0%; }
    60%  { width: 75%; }
    85%  { width: 92%; }
    100% { width: 100%; }
}
.loader-status {
    display: flex; justify-content: space-between; align-items: center;
}
.loader-status-text {
    font-family: var(--font-body);
    font-size: .95rem; letter-spacing: 2px;
    color: rgba(0,210,255,.5);
    text-transform: uppercase;
    animation: statusBlink 1.4s ease-in-out infinite;
}
.loader-status-pct {
    font-family: var(--font-body);
    font-size: .95rem; color: rgba(0,250,154,.6);
    letter-spacing: 1px;
    animation: pctCount 3.2s linear forwards;
}
@keyframes statusBlink {
    0%,100% { opacity: .4; } 50% { opacity: .9; }
}
@keyframes pctCount {
    0%   { content: '0%'; opacity: .5; }
    100% { opacity: 1; }
}

/* Corner decorations */
.loader-corner {
    position: absolute;
    width: 2.2rem; height: 2.2rem;
    border-color: rgba(0,210,255,.3);
    border-style: solid;
}
.loader-corner.tl { top: 2rem; left: 2rem; border-width: 1.5px 0 0 1.5px; }
.loader-corner.tr { top: 2rem; right: 2rem; border-width: 1.5px 1.5px 0 0; }
.loader-corner.bl { bottom: 2rem; left: 2rem; border-width: 0 0 1.5px 1.5px; }
.loader-corner.br { bottom: 2rem; right: 2rem; border-width: 0 1.5px 1.5px 0; }

/* ===== SEC LABEL ===== */
.sec-label { display: block; text-align: center; font-family: var(--font-body); font-size: 1.1rem; color: var(--ionic-blue); letter-spacing: 4px; text-transform: uppercase; margin-bottom: 1rem; opacity: 0.8; }

/* ===== SCROLL ANIMATIONS ===== */
.reveal { opacity: 0; transform: translateY(30px); transition: all .9s ease-out; }
.reveal.active { opacity: 1; transform: translateY(0); }
.slide-left { opacity: 0; transform: translateX(-80px); transition: all 1s ease-out; }
.slide-left.active { opacity: 1; transform: translateX(0); }
.slide-right { opacity: 0; transform: translateX(80px); transition: all 1s ease-out; }
.slide-right.active { opacity: 1; transform: translateX(0); }

/* ===== RESPONSIVE ===== */
@media (max-width: 991px) {
    .about, .contact-container { flex-direction: column; }
    section { padding: 10rem 5% 4rem; }
    .heading { font-size: 3.2rem; }
    .home { flex-direction: column; text-align: center; gap: 3rem; }
    .home-content h1 { font-size: 3.8rem; }
}
@media (max-width: 768px) {
    .navbar, .dash-btn { display: none; }
    .home-content h1 { font-size: 2.8rem; }
    .hexagon-svg { width: 250px; height: 280px; }
}

/* ===== MOBILE (max 600px) — K40 Gaming & similar ===== */
@media (max-width: 600px) {

    /* Disable custom cursor on touch devices */
    body { cursor: auto; }
    #cursor-dot, #cursor-ring { display: none; }
    .btn, .navbar a, .lang-switcher, .dash-btn,
    .social-media a, .bento-btn-visit, .bento-btn-desc,
    .desc-popup-close, .contact-single-input,
    .contact form textarea { cursor: pointer; }

    /* Section padding */
    section { padding: 8rem 4% 3rem; }

    /* Header / Navbar */
    .header { padding: 0.45rem 0.9rem; gap: 0.4rem; max-width: 92vw; }
    .logo img { height: 2.2rem; }
    .nav-sep { display: none; }
    .lang-switcher { font-size: 0.85rem; padding: .38rem .75rem; }

    /* Headings */
    .heading { font-size: 2.2rem; margin-bottom: 3rem; letter-spacing: 1px; }
    .sec-label { font-size: 0.9rem; letter-spacing: 3px; }

    /* Home section */
    .home { gap: 2rem; padding-top: 2rem; }
    .home-content h3 { font-size: 1.3rem; letter-spacing: 2px; }
    .home-content h1 { font-size: 2.2rem; letter-spacing: 1px; }
    .home-content h3.typerow { font-size: 1.6rem; }
    .home-content p { font-size: 1.2rem; margin: 1.2rem 0; line-height: 1.8; }
    .hexagon-svg { width: 200px; height: 230px; }
    .social-media a { width: 3.6rem; height: 3.6rem; font-size: 1.5rem; margin: 1.2rem 0.8rem 1.2rem 0; }

    /* Buttons */
    .btn { padding: 1rem 2rem; font-size: 1.1rem; }

    /* About section */
    .about { gap: 2rem; }
    .about-card { padding: 2.5rem 2rem; }
    .about-card-desc { font-size: 1.3rem; }
    .about-info-grid { grid-template-columns: 1fr 1fr; gap: 1.2rem; padding: 1.8rem 0; }
    .about-info-label { font-size: 0.95rem; }
    .about-info-value { font-size: 1.2rem; }
    .about-card-btns { gap: 1rem; }
    .about-photo { min-height: 260px; }

    /* Skills grid */
    .skills-grid { grid-template-columns: 1fr; gap: 1.8rem; }
    .skill-card { padding: 2.2rem 1.8rem; }
    .skill-card-title { font-size: 1.7rem; }
    .skill-card-desc { font-size: 1.2rem; }
    .skill-tag { font-size: 1rem; }

    /* Projects / bento grid */
    .bento-grid { grid-template-columns: 1fr; gap: 2rem; }
    .bento-img-area { height: 18rem; }
    .bento-body { padding: 2rem 1.8rem; gap: 1.2rem; }
    .bento-name { font-size: 1.7rem; }
    .bento-desc { font-size: 1.2rem; }
    .bento-btn-visit, .bento-btn-desc { font-size: 1rem; padding: 1rem; }

    /* Popup */
    .desc-popup-box { padding: 3rem 2rem; width: 94%; }
    .desc-popup-title { font-size: 2rem; margin-bottom: 1.5rem; }
    .desc-popup-text { font-size: 1.3rem; }
    .desc-popup-close { width: 3.2rem; height: 3.2rem; font-size: 1.4rem; top: 1.2rem; right: 1.2rem; }

    /* Education */
    .edu-card { padding: 2.5rem 2rem; }
    .edu-header-info h3 { font-size: 1.8rem; }
    .edu-header-info p { font-size: 1.2rem; }
    .edu-desc { font-size: 1.2rem; }

    /* Contact */
    .contact-glass-card, .contact-form-wrapper { padding: 2.5rem 2rem; }
    .tile-icon { width: 4rem; height: 4rem; font-size: 1.5rem; }
    .tile-label { font-size: 0.95rem; }
    .tile-value { font-size: 1.2rem; }
    .contact-single-input, .contact form textarea { font-size: 1.2rem; padding: 1.2rem 1.3rem; }

    /* Loader */
    .loader-avatar-wrap { width: 10rem; height: 10rem; margin-bottom: 2.4rem; }
    .loader-avatar { width: 8rem; height: 8rem; }
    .loader-name { font-size: 1.8rem; letter-spacing: 3px; }
    .loader-tag { font-size: 0.85rem; letter-spacing: 3px; margin-bottom: 2rem; }
    .loader-corner { width: 1.6rem; height: 1.6rem; }
    .loader-corner.tl, .loader-corner.tr { top: 1rem; }
    .loader-corner.bl, .loader-corner.br { bottom: 1rem; }
    .loader-corner.tl, .loader-corner.bl { left: 1rem; }
    .loader-corner.tr, .loader-corner.br { right: 1rem; }

    /* Footer */
    .footer { font-size: 1.1rem; padding: 2rem 1.5rem; }

    /* About info grid: single column on very narrow screens */
    @media (max-width: 380px) {
        .about-info-grid { grid-template-columns: 1fr; }
        .home-content h1 { font-size: 1.9rem; }
        .heading { font-size: 1.9rem; }
    }
}
