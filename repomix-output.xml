    (function() {
        var texts = ['Web & Mobile Developer','Frontend Specialist','UI/UX Enthusiast','Full-Stack Engineer'];
        var tIdx = 0, cIdx = 0, del = false;
        var typeEl = document.querySelector('.multiple-text');
        function typeLoop() {
            if (!typeEl) return;
            var cur = texts[tIdx];
            if (!del) {
                typeEl.textContent = cur.substring(0, ++cIdx);
                if (cIdx === cur.length) { del = true; setTimeout(typeLoop, 1800); return; }
            } else {
                typeEl.textContent = cur.substring(0, --cIdx);
                if (cIdx === 0) { del = false; tIdx = (tIdx + 1) % texts.length; }
            }
            setTimeout(typeLoop, del ? 60 : 100);
        }
        typeLoop();
    })();
