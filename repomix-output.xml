    </style>

    <!-- ===== MOBILE NAV SCRIPT ===== -->
    <script>
    (function() {
        var btn   = document.getElementById('hamburgerBtn');
        var nav   = document.getElementById('mobileNav');
        var close = document.getElementById('mobileNavClose');
        function openMobileNav() { nav.classList.add('open'); btn.classList.add('open'); document.body.style.overflow='hidden'; }
        window.closeMobileNav = function() { nav.classList.remove('open'); btn.classList.remove('open'); document.body.style.overflow=''; };
        if (btn)   btn.addEventListener('click', openMobileNav);
        if (close) close.addEventListener('click', closeMobileNav);
        if (nav)   nav.addEventListener('click', function(e){ if(e.target===nav) closeMobileNav(); });
    })();
    </script>

